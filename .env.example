# Production / iOS build: public URL of the Solara API (no trailing slash).
# Web on solaraweather.com uses same-origin /api (leave empty).
# Capacitor / iOS needs the public HTTPS API:
VITE_API_BASE=https://solaraweather.com

# Optional JWT secret for the local Node server (npm run server)
# JWT_SECRET=change-me-to-a-long-random-string
# PORT=8787

# Web Push public key (must match Worker VAPID_PUBLIC_KEY)
# VITE_VAPID_PUBLIC_KEY=

# Mapbox public access token (radar basemaps: dark/streets/satellite)
# Free at https://account.mapbox.com/access-tokens/
# VITE_MAPBOX_TOKEN=pk.eyJ...

# Google Maps Platform Weather API (WeatherNext 3) — NEVER put this in VITE_* or the client.
# Production (Cloudflare Worker):
#   1. Enable "Weather API" in Google Cloud Console
#   2. Create an API key (restrict to Weather API)
#   3. npx wrangler secret put GOOGLE_WEATHER_API_KEY
#   4. Redeploy the Worker (npm run deploy)
# Local Express (`npm run dev`): uncomment and set in this file (gitignored as .env)
# or in `.dev.vars` for `wrangler dev`. GOOGLE_MAPS_API_KEY is accepted as an alias.
# GOOGLE_WEATHER_API_KEY=
