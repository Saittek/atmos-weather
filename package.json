{
  "name": "weather-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run server\" \"vite\"",
    "server": "node server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:ios": "tsc -b && vite build --base ./ && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:sync": "npx cap sync ios && node scripts/fix-ios-spm-paths.mjs",
    "ios:prepare": "npm run build && npx cap sync ios && node scripts/fix-ios-spm-paths.mjs",
    "ios:fix-spm": "node scripts/fix-ios-spm-paths.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply atmos-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply atmos-db --remote",
    "cf:dev": "npm run build && wrangler dev",
    "test:smoke": "node scripts/smoke.mjs",
    "test:smoke:local": "node scripts/smoke.mjs",
    "ship:preflight": "node scripts/ship-preflight.mjs",
    "ship:ios": "node scripts/ship-preflight.mjs && node -e \"console.log('\\n→ Codemagic: start workflow ios-testflight on main\\n→ Guide: docs/SHIP_NOW.md\\n')\""
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@solara/widget": "file:plugins/solara-widget",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "web-push": "^3.6.7"
  }
}
