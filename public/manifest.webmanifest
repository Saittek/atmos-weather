{
  "name": "Solara Weather Command",
  "short_name": "Solara",
  "description": "Full weather dashboard with HQ radar, rain widget, forecasts, and severe alerts.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0b1220",
  "theme_color": "#0b1220",
  "orientation": "any",
  "categories": ["weather", "utilities"],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Live Radar",
      "short_name": "Radar",
      "description": "Full-screen weather radar",
      "url": "/radar",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Rain Widget",
      "short_name": "Rain",
      "description": "Compact rain forecast and pin watch",
      "url": "/widget",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Dashboard",
      "short_name": "Home",
      "description": "Full Solara weather dashboard",
      "url": "/",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
